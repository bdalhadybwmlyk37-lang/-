rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'bdalhadybwmlyk37@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'voiceEnabled', 'voiceGender', 'speechRate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'voiceEnabled', 'voiceGender', 'speechRate', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.voiceEnabled is bool
        && data.voiceGender is string && (data.voiceGender == 'male' || data.voiceGender == 'female')
        && (data.speechRate is number || data.speechRate is int) && data.speechRate >= 0.7 && data.speechRate <= 1.4
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFloorPlan(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'buildingType', 'totalAreaSqm', 'roomsCount',
          'darijaSummary', 'audioScript', 'rooms', 'materials', 'workPhases',
          'warningsDarija', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'buildingType', 'totalAreaSqm', 'roomsCount',
          'darijaSummary', 'audioScript', 'rooms', 'materials', 'workPhases',
          'warningsDarija', 'thumbnailDataUrl', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.buildingType is string && data.buildingType.size() >= 1 && data.buildingType.size() <= 100
        && data.totalAreaSqm is string && data.totalAreaSqm.size() >= 1 && data.totalAreaSqm.size() <= 40
        && data.roomsCount is int && data.roomsCount >= 0 && data.roomsCount <= 200
        && data.darijaSummary is string && data.darijaSummary.size() >= 1 && data.darijaSummary.size() <= 5000
        && data.audioScript is string && data.audioScript.size() >= 1 && data.audioScript.size() <= 5000
        && data.rooms is list && data.rooms.size() <= 40
        && data.materials is list && data.materials.size() <= 40
        && data.workPhases is list && data.workPhases.size() <= 20
        && data.warningsDarija is list && data.warningsDarija.size() <= 20
        && (data.warningsDarija.size() == 0 || data.warningsDarija[0] is string)
        && (!('thumbnailDataUrl' in data) || (data.thumbnailDataUrl is string && data.thumbnailDataUrl.size() <= 250000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVoiceNote(data) {
      return data.keys().hasAll(['ownerId', 'title', 'rawTranscript', 'structuredDarija', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'rawTranscript', 'structuredDarija', 'createdAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.rawTranscript is string && data.rawTranscript.size() >= 1 && data.rawTranscript.size() <= 3000
        && data.structuredDarija is string && data.structuredDarija.size() >= 1 && data.structuredDarija.size() <= 5000
        && data.createdAt is timestamp;
    }

    function isValidAccessCode(data) {
      return data.keys().hasAll(['ownerId', 'name', 'code', 'isActive', 'trials', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'code', 'isActive', 'trials', 'createdAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40
        && data.isActive is bool
        && data.trials is int && data.trials >= 0 && data.trials <= 10000
        && data.createdAt is timestamp;
    }

    function isValidTtsApiKey(data) {
      return data.keys().hasAll(['ownerId', 'key', 'order', 'status', 'lastUsed', 'failCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'key', 'order', 'status', 'lastUsed', 'failCount', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 1024
        && data.order is int && data.order >= 1 && data.order <= 20
        && data.status is string && (data.status == 'active' || data.status == 'exhausted')
        && data.lastUsed is int && data.lastUsed >= 0
        && data.failCount is int && data.failCount >= 0 && data.failCount <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'voiceEnabled', 'voiceGender', 'speechRate', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- Collection: /plans/{planId} ---
    match /plans/{planId} {
      allow get: if isSignedIn() && isValidId(planId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(planId)
        && isValidFloorPlan(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(planId)
        && existing().ownerId == request.auth.uid
        && isValidFloorPlan(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'darijaSummary', 'audioScript', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(planId) && existing().ownerId == request.auth.uid;
    }

    // --- Collection: /voiceNotes/{noteId} ---
    match /voiceNotes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(noteId)
        && isValidVoiceNote(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(noteId) && existing().ownerId == request.auth.uid;
    }

    // --- Collection: /accessCodes/{codeId} ---
    match /accessCodes/{codeId} {
      allow get: if isSignedIn() && isValidId(codeId) && (isAdmin() || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || existing().ownerId == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(codeId)
        && (isAdmin() || incoming().ownerId == request.auth.uid)
        && isValidAccessCode(incoming())
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(codeId)
        && (isAdmin() || existing().ownerId == request.auth.uid)
        && isValidAccessCode(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'isActive', 'trials']);
      allow delete: if isVerifiedUser() && isValidId(codeId) && (isAdmin() || existing().ownerId == request.auth.uid);
    }

    // --- Collection: /tts_api_keys/{keyId} ---
    match /tts_api_keys/{keyId} {
      allow get: if isAdmin() && isValidId(keyId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(keyId)
        && isValidTtsApiKey(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(keyId)
        && isValidTtsApiKey(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['key', 'order', 'status', 'lastUsed', 'failCount', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(keyId);
    }
  }
}
